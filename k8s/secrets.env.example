# Copy to k8s/secrets.env (git-ignored). scripts/k8s-up.sh generates one with random values if missing.
POSTGRES_DB=stockcart
POSTGRES_USER=stockcart
POSTGRES_PASSWORD=change-me
# >= 32 chars, e.g. openssl rand -hex 32
API_KEY=change-me-to-a-long-random-string-at-least-32-chars
REDIS_PASSWORD=change-me
