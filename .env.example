# Copy to .env and change the secrets:  cp .env.example .env
# Avoid ';' in POSTGRES_PASSWORD (it is embedded in the connection string).

# Port published on your PC -> http://localhost:8088
NGINX_PORT=8088
# Public origin of the website (used by the API's CORS policy)
FRONTEND_ORIGIN=http://localhost:8088

POSTGRES_DB=stockcart
POSTGRES_USER=stockcart
POSTGRES_PASSWORD=change-me

# Shared secret between Next.js (server side) and the .NET API, >= 32 chars.
# Generate one with:  openssl rand -hex 32
API_KEY=change-me-to-a-long-random-string-at-least-32-chars

# Max DB connections per API replica (replicas x this must stay < Postgres max_connections=200)
DB_MAX_POOL_SIZE=20

# Build-time key for Next.js Server Actions, identical for every build/replica.
# Generate with:  openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Redis (cache + stock gate). Generate with:  openssl rand -hex 24
REDIS_PASSWORD=change-me
# How often the API copies stock from Postgres (source of truth) into Redis
REDIS_STOCK_SYNC_SECONDS=30
